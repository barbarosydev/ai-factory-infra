# --- Secrets and state: never commit these -------------------------------
# Terraform state holds whatever the providers return, so it stays local.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Variable files can carry secrets; commit only examples.
*.tfvars
*.tfvars.json
!*.tfvars.example
# Environment files
.env
.env.*
!.env.example
.envrc
# Project-only kubeconfig (written by the cluster scripts)
.kube/
# Stack lock held while a script changes the shared stack (scripts/lib/common.sh)
.stack.lock/

# --- Terraform caches ----------------------------------------------------
# The lock file (.terraform.lock.hcl) IS committed.
.terraform/
# terraform test initialises each module; lock files are committed for environments only.
terraform/modules/*/.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Local tools ---------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
.claude/.cc-writes/
.ruff_cache/
.tflint.d/
__pycache__/
*.py[cod]
.idea/
.vscode/
.DS_Store
*.log
