# --- Secrets and state: never commit these -------------------------------
# Terraform state holds whatever the providers return, so it stays local.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Variable files can carry secrets; commit only examples.
*.tfvars
*.tfvars.json
!*.tfvars.example
# Environment files
.env
.env.*
!.env.example
.envrc
# Project-only kubeconfig (written by the cluster scripts)
.kube/

# --- Terraform caches ----------------------------------------------------
# The lock file (.terraform.lock.hcl) IS committed.
.terraform/
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Local tools ---------------------------------------------------------
.claude/settings.local.json
__pycache__/
*.py[cod]
.idea/
.vscode/
.DS_Store
*.log
