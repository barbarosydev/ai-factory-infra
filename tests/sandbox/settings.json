{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "task",
      "task *",
      "terraform *",
      "docker *",
      "k3d *",
      "ollama *",
      "temporal *",
      "git commit *",
      "git push *",
      "gh *"
    ]
  }
}
