fullnameOverride: "${release_name}"

additionalLabels:
  app.kubernetes.io/part-of: ai-factory

server:
  enabled: true
  replicaCount: 1
  image:
    repository: temporalio/server
    tag: "${server_image_tag}"
    pullPolicy: IfNotPresent
  podLabels:
    app.kubernetes.io/part-of: ai-factory

  config:
    logLevel: "info"
    persistence:
      defaultStore: default
      visibilityStore: visibility
      numHistoryShards: 512
      datastores:
        default:
          sql:
            createDatabase: false
            manageSchema: true
            pluginName: postgres12
            driverName: postgres12
            databaseName: "${default_db_name}"
            connectAddr: "${db_endpoint}:${db_port}"
            connectProtocol: tcp
            user: "${db_user}"
            existingSecret: "${db_secret_name}"
            secretKey: password
            maxConns: 10
            maxIdleConns: 4
            maxConnLifetime: "1h"
        visibility:
          sql:
            createDatabase: false
            manageSchema: true
            pluginName: postgres12
            driverName: postgres12
            databaseName: "${visibility_db_name}"
            connectAddr: "${db_endpoint}:${db_port}"
            connectProtocol: tcp
            user: "${db_user}"
            existingSecret: "${db_secret_name}"
            secretKey: password
            maxConns: 10
            maxIdleConns: 4
            maxConnLifetime: "1h"

    namespaces:
      create: true
      useHelmHooks: false
      namespace:
        - name: default
          retention: "${default_namespace_retention}"

  frontend:
    enabled: true
    replicaCount: 1
    service:
      # Exposed via k3s ServiceLB so k3d's 127.0.0.1:7233:7233 host port mapping
      # forwards Mac gRPC traffic (temporal CLI and SDK workers) to frontend.
      type: LoadBalancer
      port: ${grpc_port}
    # Measured about 56 MiB RSS idle (docs/architecture.md); 256Mi ceiling avoids spikes on large histories.
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        cpu: 500m
        memory: 256Mi

  history:
    enabled: true
    replicaCount: 1
    # Measured about 188 MiB RSS idle (docs/architecture.md).
    resources:
      requests:
        cpu: 50m
        memory: 192Mi
      limits:
        cpu: 1000m
        memory: 512Mi

  matching:
    enabled: true
    replicaCount: 1
    # Measured about 63 MiB RSS idle (docs/architecture.md).
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        cpu: 500m
        memory: 128Mi

  worker:
    enabled: true
    replicaCount: 1
    # Measured about 51 MiB RSS idle (docs/architecture.md).
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        cpu: 500m
        memory: 128Mi

admintools:
  enabled: false
  image:
    repository: temporalio/admin-tools
    tag: "${admin_tools_image_tag}"
    pullPolicy: IfNotPresent

web:
  enabled: true
  replicaCount: 1
  image:
    repository: temporalio/ui
    tag: "${ui_image_tag}"
    pullPolicy: IfNotPresent
  podLabels:
    app.kubernetes.io/part-of: ai-factory
  # Measured about 32 MiB RSS idle (docs/architecture.md); 128Mi ceiling handles full workflow timelines smoothly.
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 250m
      memory: 128Mi
  ingress:
    enabled: true
    className: traefik
    hosts:
      - "${ingress_host}/"

schema:
  useHelmHooks: false
  ttlSecondsAfterFinished: 86400
  podLabels:
    app.kubernetes.io/part-of: ai-factory
