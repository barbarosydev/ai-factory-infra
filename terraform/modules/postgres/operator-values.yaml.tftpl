# CloudNativePG operator (chart 0.29.1, operator 1.30.1).
replicaCount: 1

image:
  repository: ghcr.io/cloudnative-pg/cloudnative-pg
  pullPolicy: IfNotPresent
  # tag@sha256:digest renders repository:tag@sha256:digest in the Deployment and in
  # OPERATOR_IMAGE_NAME, so PostgreSQL pods' instance-manager init container is pinned too.
  tag: "${operator_image_tag}"

# Measured about 36 MiB RSS idle (docs/architecture.md).
resources:
  requests:
    cpu: 25m
    memory: 64Mi
  limits:
    cpu: 500m
    memory: 128Mi
