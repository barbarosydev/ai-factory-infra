# LiteLLM proxy (chart 1.109.1).
replicaCount: 1
nameOverride: "${release_name}"
fullnameOverride: "${release_name}"

podAnnotations:
  checksum/config: "${sha256(jsonencode({ model_routes = model_routes, ollama_api_base = ollama_api_base, store_prompts = store_prompts_in_spend_logs, spend_logs_retention = spend_logs_retention, input_cost_per_token = input_cost_per_token, output_cost_per_token = output_cost_per_token, secret_version = secret_version }))}"

image:
  repository: ghcr.io/berriai/litellm
  pullPolicy: IfNotPresent
  tag: "${image_tag}"

masterkeySecretName: "${masterkey_secret_name}"
masterkeySecretKey: "masterkey"

db:
  useExisting: true
  deployStandalone: false
  endpoint: "${db_endpoint}"
  database: "${db_name}"
  secret:
    name: "${db_secret_name}"
    usernameKey: username
    passwordKey: password

migrationJob:
  enabled: true
  ttlSecondsAfterFinished: 300
  hooks:
    argocd:
      enabled: false
    helm:
      enabled: false

resources:
  requests:
    cpu: 200m
    memory: 512Mi
  limits:
    cpu: 1000m
    memory: 2Gi

ingress:
  enabled: true
  className: traefik
  hosts:
    - host: "${ingress_host}"
      paths:
        - path: /
          pathType: Prefix

proxy_config:
  model_list:
%{ for agent, model in model_routes ~}
    - model_name: ${agent}
      litellm_params:
        model: ollama_chat/${model}
        api_base: ${ollama_api_base}
      model_info:
        input_cost_per_token: ${input_cost_per_token}
        output_cost_per_token: ${output_cost_per_token}
%{ endfor ~}
  litellm_settings:
    drop_params: true
    request_timeout: 300
    turn_off_message_logging: ${!store_prompts_in_spend_logs}
  router_settings:
    num_retries: 2
    retry_after: 2
    allowed_fails: 3
    cooldown_time: 30
  general_settings:
    master_key: os.environ/PROXY_MASTER_KEY
    store_prompts_in_spend_logs: ${store_prompts_in_spend_logs}
    store_model_in_db: true
    maximum_spend_logs_retention_period: "${spend_logs_retention}"
    maximum_daily_tag_spend_retention_period: "${spend_logs_retention}"

extraResources:
  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: "${release_name}-bootstrap-keys-v${secret_version}-${bootstrap_hash}"
      labels:
        app.kubernetes.io/part-of: ai-factory
        app.kubernetes.io/component: litellm
    spec:
      backoffLimit: 6
      ttlSecondsAfterFinished: 600
      template:
        metadata:
          labels:
            app.kubernetes.io/part-of: ai-factory
            app.kubernetes.io/component: litellm
        spec:
          restartPolicy: OnFailure
          containers:
            - name: bootstrap-keys
              image: "ghcr.io/berriai/litellm:${image_tag}"
              imagePullPolicy: IfNotPresent
              resources:
                requests:
                  cpu: 50m
                  memory: 128Mi
                limits:
                  cpu: 500m
                  memory: 256Mi
              env:
                - name: PROXY_URL
                  value: "http://${release_name}:4000"
                - name: PROXY_MASTER_KEY
                  valueFrom:
                    secretKeyRef:
                      name: "${masterkey_secret_name}"
                      key: masterkey
%{ for agent, _ in model_routes ~}
                - name: "KEY_${upper(replace(agent, "-", "_"))}"
                  valueFrom:
                    secretKeyRef:
                      name: "${release_name}-${agent}-key"
                      key: api_key
%{ endfor ~}
              command:
                - python3
                - -c
                - |
                  import json, os, sys, time, urllib.error, urllib.parse, urllib.request

                  base = os.environ["PROXY_URL"]
                  master = os.environ["PROXY_MASTER_KEY"]
                  headers = {
                      "Authorization": f"Bearer {master}",
                      "Content-Type": "application/json",
                  }

                  deadline = time.time() + 240
                  while True:
                      try:
                          req = urllib.request.Request(f"{base}/health/readiness", headers=headers)
                          with urllib.request.urlopen(req, timeout=5) as resp:
                              if resp.status == 200:
                                  break
                      except Exception:
                          pass
                      if time.time() >= deadline:
                          print("timed out waiting for LiteLLM readiness", file=sys.stderr)
                          sys.exit(1)
                      time.sleep(3)

                  agents = ${jsonencode(keys(model_routes))}
                  for agent in agents:
                      env_name = "KEY_" + agent.upper().replace("-", "_")
                      key_val = os.environ[env_name]
                      info_url = f"{base}/key/info"
                      key_headers = {
                          "Authorization": f"Bearer {key_val}",
                          "Content-Type": "application/json",
                      }
                      exists = False
                      try:
                          req = urllib.request.Request(info_url, headers=key_headers)
                          with urllib.request.urlopen(req, timeout=10) as resp:
                              exists = (resp.status == 200)
                      except urllib.error.HTTPError as e:
                          if e.code not in (400, 401, 403, 404):
                              raise

                      if not exists:
                          list_url = f"{base}/key/list?key_alias={urllib.parse.quote(agent)}"
                          req = urllib.request.Request(list_url, headers=headers)
                          with urllib.request.urlopen(req, timeout=10) as resp:
                              listed = json.loads(resp.read().decode("utf-8"))
                          if listed.get("keys"):
                              del_payload = json.dumps({"key_aliases": [agent]}).encode("utf-8")
                              del_req = urllib.request.Request(f"{base}/key/delete", data=del_payload, headers=headers, method="POST")
                              with urllib.request.urlopen(del_req, timeout=15) as resp:
                                  if resp.status != 200:
                                      print(f"failed to delete superseded key for {agent}: HTTP {resp.status}", file=sys.stderr)
                                      sys.exit(1)

                      endpoint = "/key/update" if exists else "/key/generate"
                      payload = json.dumps({
                          "key": key_val,
                          "key_alias": agent,
                          "models": [agent],
                          "max_budget": ${agent_max_budget},
                          "budget_duration": "7d",
                          "user_id": "ai-factory",
                          "metadata": {"role": agent, "app": "ai-factory"},
                      }).encode("utf-8")
                      req = urllib.request.Request(f"{base}{endpoint}", data=payload, headers=headers, method="POST")
                      with urllib.request.urlopen(req, timeout=15) as resp:
                          if resp.status != 200:
                              print(f"failed to provision key for {agent}: HTTP {resp.status}", file=sys.stderr)
                              sys.exit(1)
                      print(f"provisioned virtual key for {agent}")
